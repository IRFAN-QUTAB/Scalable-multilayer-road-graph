    # ---- Merge ----
    node_df = deg_df
    for other in [bc_df, pr_df, hc_df, cc_df]:
        node_df = node_df.merge(other, on="node_name", how="outer")

    ac_merge = ac_df[["node_name", "adapted_clustering"]]
    node_df = node_df.merge(ac_merge, on="node_name", how="left")
    node_df = node_df.fillna(0)

    for col in ["degree", "pagerank", "harmonic_closeness", "betweenness"]:
        if col in node_df.columns:
            node_df[f"{col}_rank"] = node_df[col].rank(ascending=False).astype(int)

