    print("\n  💾 Early save: node_metrics CSV...")
    node_df.to_csv(os.path.join(args.output, f"node_metrics_{timestamp}.csv"), index=False)

    # ---- Graph-level metrics ----
    components = analyzer.calculate_components("dual-directed")
    community_df, mod_info = analyzer.calculate_communities("dual-undirected")  # ← UNDIRECTED

    node_df = node_df.merge(community_df, on="node_name", how="left")

    conductance_df = analyzer.calculate_conductance(community_df)
    if len(conductance_df) > 0:
        conductance_df.to_csv(
            os.path.join(args.output, f"conductance_{timestamp}.csv"),
            index=False
        )

    path_info = analyzer.calculate_avg_path_length(sample_size=args.path_sample)
    _ = analyzer.calculate_diameter()

    random_path_info = analyzer.calculate_random_path_metrics()

    assort_global = analyzer.calculate_global_assortativity(degree_df=deg_df)
    assort_spectrum_df = analyzer.calculate_assortativity_spectrum()

    # ---- Degree distribution analysis ----
    print("\n  Degree distribution analysis...")
    pk_df = compute_pk(node_df["degree"])

    # Clauset MLE — PRIMARY
    clauset_fit = fit_power_law_clauset(node_df["degree"])
    if clauset_fit:
        print(f"       Clauset (primary): α={clauset_fit['alpha']:.4f}, "
