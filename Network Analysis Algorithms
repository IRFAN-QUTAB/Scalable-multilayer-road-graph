# DEGREE DISTRIBUTION HELPERS
# ============================================================
def compute_pk(degree_series):
    counts = degree_series.value_counts().sort_index()
    total = len(degree_series)
    return pd.DataFrame({
        "degree": counts.index,
        "count": counts.values,
        "probability": counts.values / total,
    })


def fit_power_law_ols(pk_df):
    """OLS in log-log — supplementary only. Clauset MLE is primary."""
    data = pk_df[(pk_df["degree"] > 0) & (pk_df["probability"] > 0)]
    if len(data) < 3:
        return None
    log_k = np.log(data["degree"].values.astype(float))
    log_p = np.log(data["probability"].values.astype(float))
    slope, intercept, r_val, p_val, std_err = stats.linregress(log_k, log_p)
    return {
        "gamma": -slope,
        "intercept": intercept,
        "r_squared": r_val**2,
        "std_err": std_err,
    }


def fit_power_law_clauset(degree_series):
    """
    Paper §3.1: Clauset, Shalizi, Newman (2009) MLE method.
    PRIMARY power-law fit. Compares against lognormal alternative.
    pip install powerlaw
    """
    try:
        import powerlaw
        data = degree_series.values[degree_series.values > 0]
        fit = powerlaw.Fit(data, discrete=True, verbose=False)
        R, p = fit.distribution_compare('power_law', 'lognormal')
        return {
            'alpha': fit.alpha,
            'xmin': fit.xmin,
            'KS_stat': fit.power_law.D,
            'vs_lognormal_R': R,
            'vs_lognormal_p': p,
        }
    except ImportError:
        print("       ⚠ pip install powerlaw  (for proper Clauset MLE fit)")
        return None


def compute_clustering_spectrum(node_df, cc_col="clustering_coeff"):
    sub = node_df[["degree", cc_col]].dropna()
    sub = sub[np.isfinite(sub[cc_col]) & (sub[cc_col] >= 0)]
    if len(sub) < 2:
        return pd.DataFrame(columns=["degree", "avg_clustering", "node_count"])
    grouped = sub.groupby("degree")[cc_col].agg(["mean", "count"]).reset_index()
    grouped.columns = ["degree", "avg_clustering", "node_count"]
    return grouped


def compute_adapted_clustering_spectrum(node_df):
    sub = node_df[["degree", "adapted_clustering"]].dropna()
    sub = sub[np.isfinite(sub["adapted_clustering"]) & (sub["adapted_clustering"] >= 0)]
    if len(sub) < 2:
        return pd.DataFrame(columns=["degree", "avg_adapted_clustering", "node_count"])
    grouped = sub.groupby("degree")["adapted_clustering"].agg(["mean", "count"]).reset_index()
    grouped.columns = ["degree", "avg_adapted_clustering", "node_count"]
    return grouped


