# ============================================================
# ANALYZER
# ============================================================
class DualGraphAnalyzer:
    def __init__(self, uri, user, password):
        self.driver = GraphDatabase.driver(uri, auth=(user, password))

    def close(self):
        self.driver.close()

    # ----------------------------------------------------------
    # GDS PROJECTIONS (TWO: directed + undirected)
    # ----------------------------------------------------------
    def create_directed_projection(self, graph_name="dual-directed"):
        """
        Directed dual graph for: PageRank, Betweenness, Harmonic Closeness,
        Avg Path Length, Diameter, WCC, SCC.
        These metrics either need direction or are direction-agnostic.
        """
        with self.driver.session() as session:
            try:
                session.run(f"CALL gds.graph.drop('{graph_name}', false)")
            except Exception:
                pass
            session.run(f"""
                CALL gds.graph.create.cypher(
                    '{graph_name}',
                    'MATCH (n:RoadOsm)
                     WHERE n.status = "active"
                     RETURN id(n) AS id',
                    'MATCH (n:RoadOsm)-[:CONNECTED]->(m:RoadOsm)
                     WHERE n.status = "active" AND m.status = "active"
                     RETURN id(n) AS source, id(m) AS target'
                )
            """)
        print(f"   ✓ Directed projection created: {graph_name}")

    def create_undirected_projection(self, graph_name="dual-undirected"):
        """
        Projection for standard Clustering Coefficient and Louvain.

        The underlying CONNECTED graph is already bidirectional
        (Step 3, 4, 5 of dual_graph_creation.py create both
        A→B and B→A). So we load ALL edges — GDS sees a symmetric
        directed graph, which is mathematically equivalent to an
        undirected graph for triangle counting and modularity.

        We do NOT use id(n) < id(m) filter — that would drop half
        the edges and change the community count.
        """
        with self.driver.session() as session:
            try:
                session.run(f"CALL gds.graph.drop('{graph_name}', false)")
            except Exception:
                pass
            session.run(f"""
                CALL gds.graph.create.cypher(
                    '{graph_name}',
                    'MATCH (n:RoadOsm)
                     WHERE n.status = "active"
                     RETURN id(n) AS id',
                    'MATCH (n:RoadOsm)-[:CONNECTED]->(m:RoadOsm)
                     WHERE n.status = "active" AND m.status = "active"
                     RETURN id(n) AS source, id(m) AS target'
                )
            """)
        print(f"   ✓ Bidirectional projection created: {graph_name}")

    def drop_projection(self, graph_name):
        with self.driver.session() as session:
            try:
                session.run(f"CALL gds.graph.drop('{graph_name}', false)")
            except Exception:
                pass

    # ==========================================================
    # 1. DEGREE — undirected count of distinct neighbors
    # ==========================================================
    def calculate_degree(self):
        """
        Paper §3.1: degree of a road node = how many other roads
        share a common junction with it (undirected).
        """
        print("\n  [1/12] Degree distribution...")
        with self.driver.session() as session:
            result = session.run("""
                MATCH (n:RoadOsm)
                WHERE n.status = 'active'
                OPTIONAL MATCH (n)-[:CONNECTED]-(m:RoadOsm)
                WHERE m.status = 'active'
                WITH n.name AS node_name, count(DISTINCT m) AS degree
                RETURN node_name, degree
                ORDER BY degree DESC
            """)
            df = pd.DataFrame([dict(r) for r in result])
        print(f"       nodes={len(df)}, mean_k={df['degree'].mean():.2f}, "
              f"max_k={df['degree'].max()}, min_k={df['degree'].min()}")
        return df

    # ==========================================================
    # 2. BETWEENNESS CENTRALITY — Brandes algorithm (GDS)
    # ==========================================================
    def calculate_betweenness(self, graph_name="dual-directed"):
        """
        Paper §3.2:  C_B(v) = Σ σ_st(v) / σ_st  (raw)

        Both raw and normalized values are returned.
        Normalization: C_B / [(N-1)(N-2)/2]  (undirected normalization,
        appropriate because the dual graph is bidirectional).
        """
        print("\n  [2/12] Betweenness centrality...")
        with self.driver.session() as session:
            result = session.run(f"""
                CALL gds.betweenness.stream('{graph_name}')
                YIELD nodeId, score
                WITH gds.util.asNode(nodeId) AS node, score
                RETURN node.name AS node_name,
                       score AS betweenness
                ORDER BY score DESC
            """)
            df = pd.DataFrame([dict(r) for r in result])

        # Add normalized column
        N = len(df)
        if N > 2:
            denom = (N - 1) * (N - 2) / 2.0
            df['betweenness_norm'] = df['betweenness'] / denom
        else:
            df['betweenness_norm'] = 0.0

        print(f"       raw : max={df['betweenness'].max():.4f}, "
              f"mean={df['betweenness'].mean():.4f}")
        print(f"       norm: max={df['betweenness_norm'].max():.6f}, "
              f"mean={df['betweenness_norm'].mean():.6f}")
        return df

    # ==========================================================
    # 3. PAGERANK — d=0.85 (GDS)
    # ==========================================================
    def calculate_pagerank(self, graph_name="dual-directed"):
        """Paper §3.3:  PR(v) = (1-d) + d Σ PR(u)/L(u),  d=0.85"""
        print("\n  [3/12] PageRank (d=0.85)...")
        with self.driver.session() as session:
            result = session.run(f"""
                CALL gds.pageRank.stream('{graph_name}', {{
                    dampingFactor: 0.85
                }})
                YIELD nodeId, score
                WITH gds.util.asNode(nodeId) AS node, score
                RETURN node.name AS node_name,
                       score AS pagerank
                ORDER BY score DESC
            """)
            df = pd.DataFrame([dict(r) for r in result])
        print(f"       max={df['pagerank'].max():.4f}, "
              f"mean={df['pagerank'].mean():.4f}")
        return df

    # ==========================================================
    # 4. HARMONIC CLOSENESS — GDS
    # ==========================================================
    def calculate_harmonic_closeness(self, graph_name="dual-directed"):
        """Paper §3.4:  C_H(v) = (1/(N-1)) Σ 1/d(v,u)"""
        print("\n  [4/12] Harmonic closeness...")
        with self.driver.session() as session:
            result = session.run(f"""
                CALL gds.alpha.closeness.harmonic.stream('{graph_name}')
                YIELD nodeId, centrality
                WITH gds.util.asNode(nodeId) AS node, centrality
                RETURN node.name AS node_name,
                       centrality AS harmonic_closeness
                ORDER BY centrality DESC
            """)
            df = pd.DataFrame([dict(r) for r in result])
        print(f"       max={df['harmonic_closeness'].max():.4f}, "
              f"mean={df['harmonic_closeness'].mean():.4f}")
        return df

    # ==========================================================
    # 5a. STANDARD CLUSTERING — UNDIRECTED projection
    # ==========================================================
    def calculate_clustering_gds(self, graph_name="dual-undirected"):
        """
        Paper §3.5 (standard, undirected formula):
            C(i) = 2·E_i / [k_i(k_i-1)]

        FIX: This formula is for UNDIRECTED graphs. We now run GDS on
        the undirected projection so the formula is applied correctly.
        Values are naturally in [0,1] — no clipping needed.
        """
        print("\n  [5/12] Clustering coefficient (standard, undirected)...")
        with self.driver.session() as session:
            result = session.run(f"""
                CALL gds.localClusteringCoefficient.stream('{graph_name}')
                YIELD nodeId, localClusteringCoefficient
                WITH gds.util.asNode(nodeId) AS node, localClusteringCoefficient
                RETURN node.name AS node_name,
                       localClusteringCoefficient AS clustering_coeff
                ORDER BY localClusteringCoefficient DESC
            """)
            df = pd.DataFrame([dict(r) for r in result])

        # Replace nan/inf with 0 (these come from k<2 nodes — formula undefined)
        df["clustering_coeff"] = df["clustering_coeff"].replace(
            [np.inf, -np.inf], np.nan
        ).fillna(0.0)

        # Sanity check — should never trigger with undirected projection
        max_val = df["clustering_coeff"].max()
        if max_val > 1.0 + 1e-9:
            print(f"       ⚠ WARNING: max CC = {max_val} > 1 — projection may be wrong!")

        print(f"       max={df['clustering_coeff'].max():.4f}, "
              f"mean={df['clustering_coeff'].mean():.4f}")
        return df

    # ==========================================================
    # 5b. ADAPTED CLUSTERING — DIRECTED graph
    # ==========================================================
    def calculate_adapted_clustering(self):
        """
        Paper §3.5 (adapted for directed):
            C_a(n) = #LinksBetweenNeighbours / [k_n(k_n - 1)]

        - k_n counts distinct in+out neighbors (undirected count of distinct nodes)
        - Numerator: total directed links (b)->(c) between neighbors,
          counting (b)->(c) and (c)->(b) separately
        - Denominator: k(k-1)  [not /2, because directed]

        FIX: removed silent clip(0,1). If a value > 1 appears, it's a
        formula bug and we want to see it.
        """
        print("\n  [6/12] Adapted clustering (directed)...")
        with self.driver.session() as session:
            result = session.run("""
                MATCH (a:RoadOsm)
                WHERE a.status = 'active'

                // Distinct in+out neighbors (undirected count)
                MATCH (a)-[:CONNECTED]-(neighbor:RoadOsm)
                WHERE neighbor.status = 'active'
                WITH a, collect(DISTINCT neighbor) AS neighbors
                WITH a, neighbors, size(neighbors) AS degree
                WHERE degree > 1

                // Count directed links between neighbors
                UNWIND neighbors AS b
                UNWIND neighbors AS c
                WITH a, degree, b, c
                WHERE id(b) <> id(c)
                OPTIONAL MATCH (b)-[r:CONNECTED]->(c)
                WITH a, degree, count(r) AS directed_links

                WITH a.name AS node_name,
                     degree,
                     toFloat(directed_links) / (degree * (degree - 1)) AS adapted_clustering
                RETURN node_name, degree, adapted_clustering
                ORDER BY adapted_clustering DESC
            """)
            records = [dict(r) for r in result]

        df = pd.DataFrame(records)

        # Sanity check — must be in [0, 1]
        if len(df) > 0:
            max_val = df["adapted_clustering"].max()
            min_val = df["adapted_clustering"].min()
            if max_val > 1.0 + 1e-9:
                print(f"       ⚠ WARNING: adapted CC max = {max_val} > 1 — formula bug!")
            if min_val < 0.0 - 1e-9:
                print(f"       ⚠ WARNING: adapted CC min = {min_val} < 0 — formula bug!")

        # Add nodes with degree <= 1 (clustering = 0 by convention)
        with self.driver.session() as session:
            result2 = session.run("""
                MATCH (n:RoadOsm)
                WHERE n.status = 'active'
                OPTIONAL MATCH (n)-[:CONNECTED]-(m:RoadOsm)
                WHERE m.status = 'active'
                WITH n.name AS node_name, count(DISTINCT m) AS degree
                WHERE degree <= 1
                RETURN node_name, degree, 0.0 AS adapted_clustering
            """)
            df_low = pd.DataFrame([dict(r) for r in result2])

        df = pd.concat([df, df_low], ignore_index=True)

        print(f"       nodes(k>1)={len(records)}, "
              f"max={df['adapted_clustering'].max():.4f}, "
              f"mean={df['adapted_clustering'].mean():.4f}")
        return df

    # ==========================================================
    # 6. CONNECTED COMPONENTS — BOTH WCC and SCC
    # ==========================================================
    def calculate_components(self, graph_name="dual-directed"):
        """
        Paper §3.9: connected components.

        FIX: We now report BOTH:
          - WCC (Weakly Connected): direction ignored
          - SCC (Strongly Connected): every node reachable from every other
            following edge directions

        For an undirected interpretation use WCC; for "every node reachable
        from every other" in a directed graph, SCC is the strict answer.
        """
        print("\n  [7/12] Connected components (WCC + SCC)...")
        with self.driver.session() as session:
            # Weakly Connected Components
            wcc_res = session.run(f"""
                CALL gds.wcc.stats('{graph_name}')
                YIELD componentCount, componentDistribution
                RETURN componentCount, componentDistribution
            """).single()

            # Strongly Connected Components
            try:
                scc_res = session.run(f"""
                    CALL gds.alpha.scc.stream('{graph_name}')
                    YIELD nodeId, componentId
                    RETURN componentId, count(*) AS size
                    ORDER BY size DESC
                """)
                scc_records = [dict(r) for r in scc_res]
                scc_count = len(scc_records)
                scc_largest = scc_records[0]["size"] if scc_records else 0
            except Exception as e:
                print(f"       ⚠ SCC failed ({e}), trying alternative...")
                try:
                    scc_res = session.run(f"""
                        CALL gds.scc.stream('{graph_name}')
                        YIELD nodeId, componentId
                        RETURN componentId, count(*) AS size
                        ORDER BY size DESC
                    """)
                    scc_records = [dict(r) for r in scc_res]
                    scc_count = len(scc_records)
                    scc_largest = scc_records[0]["size"] if scc_records else 0
                except Exception as e2:
                    print(f"       ⚠ SCC unavailable: {e2}")
                    scc_count = None
                    scc_largest = None

        info = {
            "wcc_count": wcc_res["componentCount"],
            "wcc_distribution": dict(wcc_res["componentDistribution"]),
            "scc_count": scc_count,
            "scc_largest_size": scc_largest,
        }
        print(f"       WCC count = {info['wcc_count']}, "
              f"SCC count = {info['scc_count']}")
        return info

    # ==========================================================
    # 7. LOUVAIN COMMUNITIES — UNDIRECTED projection
    # ==========================================================
    def calculate_communities(self, graph_name="dual-undirected"):
        """
        Paper §3.10:  Q = (1/2m) Σ [A_ij - k_i k_j/2m] δ(c_i,c_j)

        FIX: This formula assumes A_ij symmetric (undirected).
        We now run Louvain on the undirected projection so the
        modularity value matches the paper formula.
        """
        print("\n  [8/12] Louvain communities (on undirected graph)...")
        with self.driver.session() as session:
            result = session.run(f"""
                CALL gds.louvain.stream('{graph_name}')
                YIELD nodeId, communityId
                WITH gds.util.asNode(nodeId) AS node, communityId
                RETURN node.name AS node_name,
                       communityId AS community
            """)
            comm_df = pd.DataFrame([dict(r) for r in result])

            result2 = session.run(f"""
                CALL gds.louvain.stats('{graph_name}')
                YIELD modularity, communityCount
                RETURN modularity, communityCount
            """)
            rec = result2.single()
            mod_info = {
                "modularity": rec["modularity"],
                "community_count": rec["communityCount"],
            }
        print(f"       communities={mod_info['community_count']}, "
              f"Q={mod_info['modularity']:.4f}")
        return comm_df, mod_info

    # ==========================================================
    # 8. AVG PATH LENGTH — DIRECTED traversal
    # ==========================================================
    def calculate_avg_path_length(self, sample_size=6000):
        """
        Paper §3.6:  ℓ = (1/(N(N-1))) Σ d(i,j)

        FIX: traversal now uses directed edges  -[:CONNECTED*]->  so
        shortest paths follow the directed dual graph (consistent with
        BC and PR which also use directed paths).

        SAMPLED: For large graphs, samples random source nodes and
        computes shortest paths to all reachable targets. Resulting
        value is an estimate of ℓ; D from this is a LOWER BOUND on
        the true diameter.
        """
        print(f"\n  [9/12] Avg path length (sample={sample_size} sources, directed)...")
        with self.driver.session() as session:
            count_result = session.run("""
                MATCH (n:RoadOsm) WHERE n.status = 'active'
                RETURN count(n) AS cnt
            """)
            total_nodes = count_result.single()["cnt"]

            # Directed traversal — note the arrow ->
            result = session.run("""
                MATCH (source:RoadOsm)
                WHERE source.status = 'active'
                  AND rand() < toFloat($sample) / $total
                WITH collect(source) AS sources

                UNWIND sources AS s
                MATCH path = shortestPath((s)-[:CONNECTED*]->(t:RoadOsm))
                WHERE t.status = 'active' AND s <> t
                WITH length(path) AS dist
                WHERE dist > 0
                RETURN avg(dist) AS avg_path_length,
                       max(dist) AS sampled_diameter,
                       count(dist) AS pairs_computed,
                       stDev(dist) AS std_path_length
            """, sample=sample_size, total=total_nodes)

            record = result.single()
            if record and record["avg_path_length"] is not None:
                info = {
                    "avg_path_length": record["avg_path_length"],
                    "sampled_diameter": record["sampled_diameter"],
                    "pairs_computed": record["pairs_computed"],
                    "std_path_length": record["std_path_length"],
                }
                print(f"       ℓ = {info['avg_path_length']:.4f} "
                      f"(±{info['std_path_length']:.4f}), "
                      f"pairs={info['pairs_computed']}, "
                      f"sampled D = {info['sampled_diameter']}")
            else:
                info = {
                    "avg_path_length": None,
                    "sampled_diameter": None,
                    "pairs_computed": 0,
                    "std_path_length": None,
                }
                print("       ⚠ Could not compute (graph may be disconnected)")
        return info

    # ==========================================================
    # 9. DIAMETER — value comes from path length sampling
    # ==========================================================
    def calculate_diameter(self):
        """
        Paper §3.7:  D = max d(i,j)

        Sampled diameter from calculate_avg_path_length() is a LOWER BOUND.
        Reported as 'sampled_diameter' in summary — clearly labeled as
        an estimate, not exact.
        """
        print("\n  [10/12] Diameter (lower bound from sampling)...")
        print("       (value from path-length sampling step)")
        return None

    # ==========================================================
    # 10. GLOBAL ASSORTATIVITY — Newman's r
    # ==========================================================
    def calculate_global_assortativity(self, degree_df=None):
        """
        Paper §3.8:
            r = [M⁻¹ Σ jk - (M⁻¹ Σ ½(j+k))²] /
                [M⁻¹ Σ ½(j²+k²) - (M⁻¹ Σ ½(j+k))²]

        FIX: Edges are now deduped (id(a) < id(b)) so each undirected
        edge is counted exactly once, as Newman's formula requires.
        Degrees are undirected (in+out distinct neighbors).
        """
        print("\n  [11/12] Global assortativity (Newman's r)...")

        if degree_df is None:
            print("       ⚠ degree_df missing")
            return {"assortativity_r": None, "edge_count": 0}

        deg_map = dict(zip(degree_df["node_name"], degree_df["degree"]))

        with self.driver.session() as session:
            # Each undirected edge once — id filter avoids double-count
            result = session.run("""
                MATCH (a:RoadOsm)-[:CONNECTED]-(b:RoadOsm)
                WHERE a.status = 'active' AND b.status = 'active'
                  AND id(a) < id(b)
                RETURN a.name AS source, b.name AS target
            """)
            edges = [(r["source"], r["target"]) for r in result]

        M = len(edges)
        print(f"       unique edges = {M}")

        if M == 0:
            return {"assortativity_r": None, "edge_count": 0}

        js = np.array([deg_map.get(s, 0) for s, _ in edges], dtype=float)
        ks = np.array([deg_map.get(t, 0) for _, t in edges], dtype=float)

        # Newman 2002 formula
        jk_mean = np.mean(js * ks)
        jk_sum_half = np.mean(0.5 * (js + ks))
        jk_sq_half = np.mean(0.5 * (js**2 + ks**2))

        numerator = jk_mean - jk_sum_half**2
        denominator = jk_sq_half - jk_sum_half**2

        r = numerator / denominator if denominator != 0 else 0.0

        print(f"       r = {r:.6f}  ({'Assortative' if r > 0 else 'Disassortative'})")
        return {"assortativity_r": r, "edge_count": M}

    # ==========================================================
    # RANDOM PATH METRICS
    # ==========================================================
    def calculate_random_path_metrics(self):
        """
        Random path average length + average cost.

        Matches the original resilience analysis logic exactly:
          - 1500 random source-target pairs
          - Undirected traversal: [:CONNECTED*]-
          - Cost = sum of relationship.score (default 1.0)
          - Length = number of hops
          - Skips closed roads (n.temp_status IS NULL)
        """
        print(f"\n  [+] Random path metrics...")

        # ---- avg cost ----
        with self.driver.session() as session:
            try:
                result = session.run("""
                    MATCH (source:RoadOsm), (target:RoadOsm)
                    WHERE source.temp_status IS NULL AND target.temp_status IS NULL
                      AND source <> target
                    WITH source, target, rand() AS r
                    ORDER BY r
                    LIMIT 1500
                    MATCH path = shortestPath((source)-[:CONNECTED*]-(target))
                    WITH path,
                         reduce(cost = 0.0, rel IN relationships(path) |
                                cost + coalesce(rel.score, 1.0)) AS pathCost
                    RETURN avg(pathCost) AS avg_cost
                """)
                rec = result.single()
                avg_cost = rec["avg_cost"] if rec and rec["avg_cost"] is not None else None
            except Exception as e:
                print(f"       ⚠ random path cost failed: {e}")
                avg_cost = None

        # ---- avg length ----
        with self.driver.session() as session:
            try:
                result = session.run("""
                    MATCH (source:RoadOsm), (target:RoadOsm)
                    WHERE source.temp_status IS NULL AND target.temp_status IS NULL
                      AND source <> target
                    WITH source, target, rand() AS r
                    ORDER BY r
                    LIMIT 1500
                    MATCH path = shortestPath((source)-[:CONNECTED*]-(target))
                    RETURN avg(length(path)) AS avg_length
                """)
                rec = result.single()
                avg_length = rec["avg_length"] if rec and rec["avg_length"] is not None else None
            except Exception as e:
                print(f"       ⚠ random path length failed: {e}")
                avg_length = None

        info = {
            "random_path_avg_length": avg_length,
            "random_path_avg_cost": avg_cost,
        }
        print(f"       avg length = {avg_length}, avg cost = {avg_cost}")
        return info

    # ==========================================================
    # 11. ASSORTATIVITY SPECTRUM  k_nn(k)
    # ==========================================================
    def calculate_assortativity_spectrum(self):
        """
        k_nn(k) = average degree of neighbors of nodes with degree k.
        Uses undirected degree (consistent with §3.1).
        """
        print("\n  [12/12] Assortativity spectrum k_nn(k)...")
        with self.driver.session() as session:
            result = session.run("""
                MATCH (a:RoadOsm)
                WHERE a.status = 'active'

                MATCH (a)-[:CONNECTED]-(neighbor:RoadOsm)
                WHERE neighbor.status = 'active'
                WITH a, count(DISTINCT neighbor) AS degree_a

                MATCH (a)-[:CONNECTED]-(n:RoadOsm)
                WHERE n.status = 'active'
                MATCH (n)-[:CONNECTED]-(nn:RoadOsm)
                WHERE nn.status = 'active'
                WITH a, degree_a, n, count(DISTINCT nn) AS neighbor_degree

                WITH degree_a, avg(neighbor_degree) AS avg_nn_degree

                RETURN degree_a AS degree,
                       avg(avg_nn_degree) AS avg_neighbor_degree,
                       count(*) AS node_count
                ORDER BY degree_a
            """)
            df = pd.DataFrame([dict(r) for r in result])
        print(f"       degree levels = {len(df)}")
        return df

    # ==========================================================
    # CONDUCTANCE PER COMMUNITY
    # ==========================================================
    def calculate_conductance(self, community_df):
        """
        Edge-ratio conductance per community:
            external_edges / total_edges_of_community

        (Simpler form than full Cheeger conductance, but consistent
         within and across communities for comparison.)
        """
        print("\n  [+] Community conductance...")
        comm_map = dict(zip(community_df["node_name"], community_df["community"]))

        with self.driver.session() as session:
            result = session.run("""
                MATCH (a:RoadOsm)-[:CONNECTED]->(b:RoadOsm)
                WHERE a.status = 'active' AND b.status = 'active'
                RETURN a.name AS source, b.name AS target
            """)
            edges = [dict(r) for r in result]

        community_internal = {}
        community_total = {}

        for e in edges:
            src_comm = comm_map.get(e["source"])
            tgt_comm = comm_map.get(e["target"])
            if src_comm is None or tgt_comm is None:
                continue
            community_total[src_comm] = community_total.get(src_comm, 0) + 1
            if src_comm == tgt_comm:
                community_internal[src_comm] = community_internal.get(src_comm, 0) + 1

        comm_sizes = community_df['community'].value_counts()
        valid_communities = set(comm_sizes[comm_sizes > 3].index)

        conductance_records = []
        for comm_id in community_total:
            if comm_id not in valid_communities:
                continue
            total = community_total[comm_id]
            internal = community_internal.get(comm_id, 0)
            external = total - internal
            cond = external / total if total > 0 else 0.0
            size = len(community_df[community_df["community"] == comm_id])
            conductance_records.append({
                "community": comm_id,
                "size": size,
                "internal_edges": internal,
                "external_edges": external,
                "total_edges": total,
                "conductance": cond,
            })

        cond_df = pd.DataFrame(conductance_records)
        if len(cond_df) > 0:
            cond_df = cond_df.sort_values("size", ascending=False).reset_index(drop=True)
            print(f"       max={cond_df['conductance'].max():.4f}, "
                  f"mean={cond_df['conductance'].mean():.4f}, "
                  f"min={cond_df['conductance'].min():.4f}")
        return cond_df

    # ==========================================================
    # STORE METRICS — UNWIND batch (fast)
    # ==========================================================
    def store_metrics(self, df):
        """Store computed metrics back to Neo4j as node properties."""
        print("\n  Storing metrics on nodes (UNWIND batch)...")
        cols_to_store = [
            "pagerank", "harmonic_closeness", "degree",
            "clustering_coeff", "betweenness", "community",
            "adapted_clustering",
        ]
        available = [c for c in cols_to_store if c in df.columns]
        if not available:
            return

        rows = []
        for _, row in df.iterrows():
            r = {"name": row["node_name"]}
            for c in available:
                v = row[c]
                r[c] = float(v) if pd.notna(v) else None
            rows.append(r)

        set_clauses = ", ".join([f"n.{c} = row.{c}" for c in available])

        with self.driver.session() as session:
            # Process in chunks to avoid huge transactions
            chunk_size = 1000
            for i in range(0, len(rows), chunk_size):
                chunk = rows[i:i + chunk_size]
                session.run(f"""
                    UNWIND $rows AS row
                    MATCH (n:RoadOsm {{name: row.name}})
                    SET {set_clauses}
                """, rows=chunk)
        print(f"       ✓ Stored {len(available)} metrics on {len(rows)} nodes")


