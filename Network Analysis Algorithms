    analyzer = DualGraphAnalyzer(args.neo4jURL, args.neo4juser, args.neo4jpwd)
    start = time.time()

    # ---- Both projections ----
    print("\n  Creating GDS projections...")
    analyzer.create_directed_projection("dual-directed")
    analyzer.create_undirected_projection("dual-undirected")

    # ---- Node-level metrics ----
    deg_df = analyzer.calculate_degree()
    bc_df = analyzer.calculate_betweenness("dual-directed")
    pr_df = analyzer.calculate_pagerank("dual-directed")
    hc_df = analyzer.calculate_harmonic_closeness("dual-directed")
    cc_df = analyzer.calculate_clustering_gds("dual-undirected")  # ← UNDIRECTED
